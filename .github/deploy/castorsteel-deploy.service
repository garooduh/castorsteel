[Unit]
Description=Publish a checked CastorSteel release
Wants=network-online.target
After=network-online.target nginx.service

[Service]
Type=oneshot
User=castorsteel-deploy
StateDirectory=castorsteel
StateDirectoryMode=0755
ExecStart=/usr/bin/python3 /usr/local/lib/castorsteel/pull_release.py
TimeoutStartSec=2min
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
